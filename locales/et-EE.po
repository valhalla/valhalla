msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES> onto <STREET_NAMES>."
msgstr "<CROSS_STREET_NAMES> teeristis pööra <RELATIVE_DIRECTION> tagasi <STREET_NAMES> teele."

#. e.g. Make a left U-turn at Devonshire Road to stay on Jonestown Road/US 22.
#: instructions.uturn.phrases.5
msgctxt "instructions.uturn.phrases.5"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES> to stay on <STREET_NAMES>."
msgstr "<CROSS_STREET_NAMES> teeristis pööra <RELATIVE_DIRECTION> tagasi ja jää <STREET_NAMES> teele."

