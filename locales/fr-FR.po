msgid "Make a <RELATIVE_DIRECTION> U-turn to stay on <STREET_NAMES>."
msgstr "Faites demi-tour à <RELATIVE_DIRECTION> pour rester sur <STREET_NAMES>."

#. e.g. Make a left U-turn at Devonshire Road.
#: instructions.uturn_verbal.phrases.3
msgctxt "instructions.uturn_verbal.phrases.3"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES>."
msgstr "Faites demi-tour à <RELATIVE_DIRECTION> à <CROSS_STREET_NAMES>."

#. e.g. Make a left U-turn at Devonshire Road onto Jonestown Road, U.S. 22.
#: instructions.uturn_verbal.phrases.4
msgctxt "instructions.uturn_verbal.phrases.4"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES> onto <STREET_NAMES>."
msgstr "Faites demi-tour à <RELATIVE_DIRECTION> à <CROSS_STREET_NAMES> dans <STREET_NAMES>."

#. e.g. Make a left U-turn at Devonshire Road to stay on Jonestown Road, U.S. 22.
#: instructions.uturn_verbal.phrases.5
msgctxt "instructions.uturn_verbal.phrases.5"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES> to stay on <STREET_NAMES>."
msgstr "Faites demi-tour à <RELATIVE_DIRECTION> à <CROSS_STREET_NAMES> pour rester sur <STREET_NAMES>."

#. e.g. Make a right U-turn at Mannenbashi East.
#: instructions.uturn_verbal.phrases.6
msgctxt "instructions.uturn_verbal.phrases.6"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <JUNCTION_NAME>."
msgstr "Faites demi-tour à <RELATIVE_DIRECTION> à <JUNCTION_NAME>."

#. e.g. Make a left U-turn toward Baltimore.
#: instructions.uturn_verbal.phrases.7
msgctxt "instructions.uturn_verbal.phrases.7"
msgid "Make a <RELATIVE_DIRECTION> U-turn toward <TOWARD_SIGN>."
msgstr "Faites demi-tour à <RELATIVE_DIRECTION> vers <TOWARD_SIGN>."

#: instructions.uturn_verbal.relative_directions.0
msgctxt "instructions.uturn_verbal.relative_directions.0"
msgid "left"
msgstr "gauche"

#: instructions.uturn_verbal.relative_directions.1
msgctxt "instructions.uturn_verbal.relative_directions.1"
msgid "right"
msgstr "droite"

#: instructions.verbal_multi_cue.metric_lengths.0
msgctxt "instructions.verbal_multi_cue.metric_lengths.0"
msgid "<KILOMETERS> kilometers"
msgstr "<KILOMETERS> kilomètres"

#: instructions.verbal_multi_cue.metric_lengths.1
msgctxt "instructions.verbal_multi_cue.metric_lengths.1"
msgid "1 kilometer"
msgstr "1 kilometre"

#: instructions.verbal_multi_cue.metric_lengths.2
msgctxt "instructions.verbal_multi_cue.metric_lengths.2"
msgid "<METERS> meters"
msgstr "<METERS> mètres"

#: instructions.verbal_multi_cue.metric_lengths.3
msgctxt "instructions.verbal_multi_cue.metric_lengths.3"
msgid "less than 10 meters"
msgstr "moins de 10 mètres"

#. e.g. Bear right onto East Fayette Street. Then Turn right onto North Gay Street.
#: instructions.verbal_multi_cue.phrases.0
msgctxt "instructions.verbal_multi_cue.phrases.0"
msgid "<CURRENT_VERBAL_CUE> Then <NEXT_VERBAL_CUE>"
msgstr "<CURRENT_VERBAL_CUE> Ensuite, <NEXT_VERBAL_CUE>"

#. e.g. Bear right onto East Fayette Street. Then, in 500 feet, Turn right onto North Gay Street.
#: instructions.verbal_multi_cue.phrases.1
msgctxt "instructions.verbal_multi_cue.phrases.1"
msgid "<CURRENT_VERBAL_CUE> Then, in <LENGTH>, <NEXT_VERBAL_CUE>"
msgstr "<CURRENT_VERBAL_CUE> Ensuite, dans <LENGTH>, <NEXT_VERBAL_CUE>"

#: instructions.verbal_multi_cue.us_customary_lengths.0
msgctxt "instructions.verbal_multi_cue.us_customary_lengths.0"
msgid "<MILES> miles"
msgstr ""

#: instructions.verbal_multi_cue.us_customary_lengths.1
msgctxt "instructions.verbal_multi_cue.us_customary_lengths.1"
msgid "1 mile"
msgstr ""

#: instructions.verbal_multi_cue.us_customary_lengths.2
msgctxt "instructions.verbal_multi_cue.us_customary_lengths.2"
msgid "a half mile"
msgstr "un demi mile"

#: instructions.verbal_multi_cue.us_customary_lengths.3
msgctxt "instructions.verbal_multi_cue.us_customary_lengths.3"
msgid "a quarter mile"
msgstr "un quart de mile"

#: instructions.verbal_multi_cue.us_customary_lengths.4
msgctxt "instructions.verbal_multi_cue.us_customary_lengths.4"
msgid "<FEET> feet"
msgstr "<FEET> pieds"

#: instructions.verbal_multi_cue.us_customary_lengths.5
msgctxt "instructions.verbal_multi_cue.us_customary_lengths.5"
msgid "less than 10 feet"
msgstr "moins de 10 pieds"
