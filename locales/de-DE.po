msgid "Make a <RELATIVE_DIRECTION> U-turn at <JUNCTION_NAME>."
msgstr "An <JUNCTION_NAME> eine Kehrtwende nach <RELATIVE_DIRECTION> machen."

#. e.g. Make a left U-turn toward Baltimore.
#: instructions.uturn.phrases.7
msgctxt "instructions.uturn.phrases.7"
msgid "Make a <RELATIVE_DIRECTION> U-turn toward <TOWARD_SIGN>."
msgstr "In Richtung <TOWARD_SIGN> eine Kehrtwende nach <RELATIVE_DIRECTION> machen."

#: instructions.uturn.relative_directions.0
msgctxt "instructions.uturn.relative_directions.0"
msgid "left"
msgstr "links"

#: instructions.uturn.relative_directions.1
msgctxt "instructions.uturn.relative_directions.1"
msgid "right"
msgstr "rechts"

#: instructions.uturn_verbal.empty_street_name_labels.0
msgctxt "instructions.uturn_verbal.empty_street_name_labels.0"
msgid "the walkway"
msgstr "Fußweg"

#: instructions.uturn_verbal.empty_street_name_labels.1
msgctxt "instructions.uturn_verbal.empty_street_name_labels.1"
msgid "the cycleway"
msgstr "Radweg"

#: instructions.uturn_verbal.empty_street_name_labels.2
msgctxt "instructions.uturn_verbal.empty_street_name_labels.2"
msgid "the mountain bike trail"
msgstr "Mountainbike-Strecke"

#: instructions.uturn_verbal.empty_street_name_labels.3
msgctxt "instructions.uturn_verbal.empty_street_name_labels.3"
msgid "the crosswalk"
msgstr "Fußgängerübergang"

#: instructions.uturn_verbal.empty_street_name_labels.4
msgctxt "instructions.uturn_verbal.empty_street_name_labels.4"
msgid "the stairs"
msgstr "die Treppe"

#: instructions.uturn_verbal.empty_street_name_labels.5
msgctxt "instructions.uturn_verbal.empty_street_name_labels.5"
msgid "the bridge"
msgstr "die Brücke"

#: instructions.uturn_verbal.empty_street_name_labels.6
msgctxt "instructions.uturn_verbal.empty_street_name_labels.6"
msgid "the tunnel"
msgstr "der Tunnel"

#. e.g. Make a left U-turn.
#: instructions.uturn_verbal.phrases.0
msgctxt "instructions.uturn_verbal.phrases.0"
msgid "Make a <RELATIVE_DIRECTION> U-turn."
msgstr "Nach <RELATIVE_DIRECTION> eine Kehrtwende machen."

#. e.g. Make a right U-turn onto Bunker Hill Road.
#: instructions.uturn_verbal.phrases.1
msgctxt "instructions.uturn_verbal.phrases.1"
msgid "Make a <RELATIVE_DIRECTION> U-turn onto <STREET_NAMES>."
msgstr "Nach <RELATIVE_DIRECTION> eine Kehrtwende auf <STREET_NAMES> machen."

#. e.g. Make a left U-turn to stay on Bunker Hill Road.
#: instructions.uturn_verbal.phrases.2
msgctxt "instructions.uturn_verbal.phrases.2"
msgid "Make a <RELATIVE_DIRECTION> U-turn to stay on <STREET_NAMES>."
msgstr "Nach <RELATIVE_DIRECTION> eine Kehrtwende machen um auf <STREET_NAMES> zu bleiben."

#. e.g. Make a left U-turn at Devonshire Road.
#: instructions.uturn_verbal.phrases.3
msgctxt "instructions.uturn_verbal.phrases.3"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES>."
msgstr "Nach <RELATIVE_DIRECTION> eine Kehrtwende bei <CROSS_STREET_NAMES> machen."

#. e.g. Make a left U-turn at Devonshire Road onto Jonestown Road, U.S. 22.
#: instructions.uturn_verbal.phrases.4
msgctxt "instructions.uturn_verbal.phrases.4"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES> onto <STREET_NAMES>."
msgstr "Nach <RELATIVE_DIRECTION> eine Kehrtwende bei <CROSS_STREET_NAMES> auf <STREET_NAMES> machen."

#. e.g. Make a left U-turn at Devonshire Road to stay on Jonestown Road, U.S. 22.
#: instructions.uturn_verbal.phrases.5
msgctxt "instructions.uturn_verbal.phrases.5"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <CROSS_STREET_NAMES> to stay on <STREET_NAMES>."
msgstr "Nach <RELATIVE_DIRECTION> eine Kehrtwende bei <CROSS_STREET_NAMES> machen um auf <STREET_NAMES> zu bleiben."

#. e.g. Make a right U-turn at Mannenbashi East.
#: instructions.uturn_verbal.phrases.6
msgctxt "instructions.uturn_verbal.phrases.6"
msgid "Make a <RELATIVE_DIRECTION> U-turn at <JUNCTION_NAME>."
msgstr "An <JUNCTION_NAME> eine Kehrtwende nach <RELATIVE_DIRECTION> machen."

#. e.g. Make a left U-turn toward Baltimore.
#: instructions.uturn_verbal.phrases.7
msgctxt "instructions.uturn_verbal.phrases.7"
msgid "Make a <RELATIVE_DIRECTION> U-turn toward <TOWARD_SIGN>."
msgstr "In Richtung <TOWARD_SIGN> eine Kehrtwende nach <RELATIVE_DIRECTION> machen."

